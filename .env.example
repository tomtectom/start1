# Kopiere diese Datei nach .env und fülle die Werte aus.

# Sicherheit – langer, zufälliger String (z.B. openssl rand -hex 32)
SECRET_KEY=aendere-mich-in-produktion

# App-Name (erscheint im Browser-Titel und E-Mails)
APP_NAME=Meine App

# Öffentliche URL deiner App (für Reset-Links in E-Mails)
BASE_URL=https://deine-domain.de

# Datenbank – Standard ist SQLite (./instance/app.db)
# Für PostgreSQL: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///app.db

# E-Mail (SMTP) – für Passwort-Reset
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=deine@gmail.com
MAIL_PASSWORD=dein-app-passwort
MAIL_DEFAULT_SENDER=deine@gmail.com
